class MoveZeroes {
    public void moveZeroes(int[] nums) {
        int left = 0;  // position to place next non-zero
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != 0) {
                // swap nums[i] and nums[left]
                int temp = nums[left];
                nums[left] = nums[i];
                nums[i] = temp;
                left++;
            }
        }
    }
}
